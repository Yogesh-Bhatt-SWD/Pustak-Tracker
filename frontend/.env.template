# PustakTracker - Frontend Environment Configuration
# Copy this to .env.production and .env.local, then fill in actual values
# The build process uses the VITE_ prefix for frontend environment variables

# Backend API URL (MUST be HTTPS in production)
# Example: https://api.yourdomain.com
VITE_BACKEND_URL=https://api.yourdomain.com

# Optional: Enable debug mode (set to false in production)
VITE_DEBUG=false
