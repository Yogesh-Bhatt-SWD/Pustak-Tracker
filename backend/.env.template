# PustakTracker - Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit the .env file to version control

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=production

# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# MUST be different from the default 'dev-only-secret-key'
SECRET_KEY=your-production-secret-key-here-min-32-bytes

# JWT secret key for token signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# MUST be different from the default 'dev-only-jwt-key'
JWT_SECRET_KEY=your-production-jwt-secret-key-here-min-32-bytes

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Format: mysql+mysqlconnector://username:password@host:port/database
# Example: mysql+mysqlconnector://pustak_prod:strong_pass@db.example.com:3306/pustak_tracker_prod
DATABASE_URL=mysql+mysqlconnector://username:password@localhost:3306/pustak_tracker_prod

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins (HTTPS only in production)
# Example: https://library.example.com,https://app.example.com
# DO NOT use * in production - this is a critical security requirement
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Leave empty if email notifications not needed, otherwise configure SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password  # Use app-specific password for Gmail

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Port to run the application on
PORT=5000

# Fine rate (daily fine amount in currency units)
FINE_RATE=5

# ============================================================================
# PRODUCTION ONLY - SECURITY SETTINGS
# ============================================================================
# When FLASK_ENV=production, the following are enforced:
# 1. SECRET_KEY must not contain 'dev-only' or 'change-in-production'
# 2. JWT_SECRET_KEY must not contain 'dev-only' or 'change-in-production'
# 3. DATABASE_URL must be explicitly set (no default fallback)
# 4. CORS_ORIGINS must be explicitly configured
# 5. Debug mode is automatically disabled
# 6. All error messages are sanitized (no internal details exposed)
# 7. Rate limiting is active on auth endpoints
